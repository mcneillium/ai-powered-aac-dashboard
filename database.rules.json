{
  "rules": {
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.role === 'admin'",
        "role": {
          ".validate": "newData.isString() && (newData.val() === 'admin' || newData.val() === 'caregiver')"
        },
        "caregiverId": {
          ".write": "auth != null && (auth.token.role === 'admin' || auth.uid === newData.val())",
          ".validate": "newData.isString() || newData.val() === null"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().matches(/^[^@]+@[^@]+$/)"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        }
      }
    },

    "caregivers": {
      ".read": "auth != null",
      "$caregiverId": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.role === 'admin'",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().matches(/^[^@]+@[^@]+$/)"
        }
      }
    },

    "userLogs": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$logId": {
        ".validate": "newData.hasChildren(['action', 'timestamp'])",
        "action": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "timestamp": {
          ".validate": "newData.isNumber()"
        },
        "targetUserId": {
          ".validate": "newData.isString()"
        },
        "carerId": {
          ".validate": "newData.isString()"
        },
        "userId": {
          ".validate": "newData.isString()"
        }
      }
    },

    "userSync": {
      "$userId": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.uid === $userId || auth.token.role === 'admin')",
        "lastActivity": {
          ".validate": "newData.isNumber()"
        }
      }
    },

    "customVocab": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.uid === $uid || auth.token.role === 'admin')"
      }
    },

    "vocabRequests": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.uid === $uid || auth.token.role === 'admin')"
      }
    },

    "userSettings": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.role === 'admin')",
        ".write": "auth != null && (auth.uid === $uid || auth.token.role === 'admin')"
      }
    },

    "fineTuneMetrics": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.role === 'admin'",
      "$metricId": {
        ".validate": "newData.hasChildren(['epoch'])",
        "epoch": {
          ".validate": "newData.isNumber()"
        },
        "loss": {
          ".validate": "newData.isNumber()"
        },
        "accuracy": {
          ".validate": "newData.isNumber()"
        }
      }
    },

    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
